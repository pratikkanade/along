{
  "name": "rally-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "cdc:apply-views": "tsx src/scripts/apply-cdc-views.ts",
    "cdc:test-rating": "tsx src/scripts/insert-cdc-test-rating.ts",
    "cdc:verify-rating": "tsx src/scripts/verify-cdc-rating.ts",
    "verify:postgres": "tsx src/scripts/verify-postgres.ts",
    "verify:embeddings": "tsx src/scripts/verify-embeddings.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@fastify/cors": "^11.1.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
