HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000

PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSL=true
# Keep true in production. Set false only if the provider gives no CA bundle and
# the direct endpoint's certificate chain cannot be verified by Node.
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=10

CLICKHOUSE_URL=https://your-service.region.provider.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Required when POST /api/intents receives free text without activity_key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
